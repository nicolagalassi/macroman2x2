/*
 * SPDX-License-Identifier: MIT
 *
 * Macropad 2x2 su Seeed XIAO nRF52840 (seeeduino_xiao_ble).
 *
 * Cablaggio: nessuna matrice, ogni switch collega un pin a GND.
 *   posizione 0 -> D9  (P1.14)
 *   posizione 1 -> D6  (P1.11)
 *   posizione 2 -> D1  (P0.03)
 *   posizione 3 -> D3  (P0.29)  <- tasto funzione
 *
 * GPIO_ACTIVE_LOW | GPIO_PULL_UP: pull-up interno, il tasto tira il pin a massa.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios
            = <&xiao_d 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&xiao_d 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    /* Il driver diretto genera eventi con row 0 e colonna = indice in input-gpios. */
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <1>;
        map = <
        //  D9      D6
            RC(0,0) RC(0,1)
        //  D1      D3 (Fn)
            RC(0,2) RC(0,3)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "2x2";
        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys  //                     w   h    x    y   rot   rx   ry
            = <&key_physical_attrs 100 100    0    0     0    0    0>
            , <&key_physical_attrs 100 100  100    0     0    0    0>
            , <&key_physical_attrs 100 100    0  100     0    0    0>
            , <&key_physical_attrs 100 100  100  100     0    0    0>
            ;
    };
};
